{
  "name": "link-shortener",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant URL shortener with click analytics, deployed on Cloudflare Workers + Supabase",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "typescript": "^7.0.2",
    "vite": "6.4.5",
    "vitest": "5.0.5",
    "wrangler": "^4.165.0"
  }
}
