{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "link-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },

  // Both hostnames serve this Worker: masresenas.cl is the primary domain for
  // new short links, shorter.juancode.dev stays so already-printed QR codes keep
  // resolving.
  "routes": [
    { "pattern": "masresenas.cl", "custom_domain": true },
    { "pattern": "shorter.juancode.dev", "custom_domain": true }
  ],
  // Nothing in the project uses the *.workers.dev URL; keep it off so the
  // Worker is only reachable through the custom domains above.
  "workers_dev": false,

  "ratelimits": [
    {
      "name": "GATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SHORT_URL_CACHE",
      "id": "5085f292ee1f4e6d9cb1747d0c8edcd5"
    },
    {
      "binding": "TENANT_CACHE",
      "id": "0498b61fb8d74c5ba9289d291825d068"
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b0a3e0bd8a7d4f85b3eb790baf3939c3",
      "localConnectionString": "postgresql://postgres:postgres@localhost:54322/postgres"
    }
  ],

  "vars": {
    "SHORT_URL_DOMAIN": "masresenas.cl",
    "ENVIRONMENT": "development",
    "MAX_ACTIVE_LINKS": "500",
    "BILLING_CONTACT": "mailto:jmunoz@juancode.dev"
  }
}
