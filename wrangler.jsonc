{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "link-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },

  "kv_namespaces": [
    {
      "binding": "SHORT_URL_CACHE",
      "id": "5085f292ee1f4e6d9cb1747d0c8edcd5"
    },
    {
      "binding": "TENANT_CACHE",
      "id": "0498b61fb8d74c5ba9289d291825d068"
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b0a3e0bd8a7d4f85b3eb790baf3939c3",
      "localConnectionString": "postgresql://postgres:duleVXr6Z57iZ6Wv@db.fjdypirneeadkqxhogaz.supabase.co:5432/postgres"
    }
  ],

  "vars": {
    "SHORT_URL_DOMAIN": "shorter.juancode.dev",
    "ENVIRONMENT": "development"
  }
}
